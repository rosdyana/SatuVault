@page
@model SatuVault.Pages.Account.DevSignInModel
@{
    ViewData["Title"] = "Developer sign in";
}
<div class="center-card">
    <h1>Developer sign in</h1>
    <p class="note info">@Html.Icon("info")<span>Development mode only. Production signs in with Microsoft Entra ID.</span></p>
    <form method="post" class="stack panel">
        <input type="hidden" asp-for="ReturnUrl">
        <label>Email <input asp-for="Email" type="email" required autofocus placeholder="name@company.com"></label>
        <div class="form-actions"><button>Sign in</button></div>
    </form>
</div>
